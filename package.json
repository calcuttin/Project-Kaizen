{
  "name": "kaizen",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Kaizen — a life operating system for continuous improvement",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run --exclude 'e2e/**'",
    "test:watch": "vitest --exclude 'e2e/**'",
    "test:e2e": "playwright test",
    "test:e2e:cloud": "playwright test -c playwright.cloud.config.ts",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "measure:load": "node scripts/measure-initial-load.mjs",
    "check:schema-types": "node scripts/check-schema-types.mjs",
    "check:public-source": "node scripts/check-public-source.mjs"
  },
  "dependencies": {
    "@clerk/react": "^6.15.1",
    "@supabase/supabase-js": "^2.57.4",
    "date-fns": "^4.4.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.40.0",
    "nanoid": "^6.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "github-slugger": "^2.0.0",
    "marked": "^18.1.1",
    "supabase": "^2.121.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
