# Device mode is the zero-configuration default. Set cloud to enable Clerk sign-in and Supabase sync.
VITE_KAIZEN_MODE=device

# Required only in cloud mode. These values are safe to expose to the browser.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Hosted deployment URL used for authentication redirects.
VITE_APP_URL=http://localhost:5180
VITE_ENABLE_BUNDLED_IMPORTS=false

# The same account can switch experiences. This only sets the default for a new account.
VITE_KAIZEN_PRODUCT=full
# Enable for static hosts without SPA rewrites (for example the Bookshelf Site).
VITE_KAIZEN_HASH_ROUTING=false
